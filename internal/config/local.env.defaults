# Dev defaults of the clinic build, embedded at build time. They are public:
# every secret below is a dev value, and a stamped release build refuses to
# start with any of them. Real values go in local.env (git-ignored; start from
# local.env.example), where a non-empty value replaces the default below.
PORT=55555
JWT_SECRET=dev-only-clinic-jwt-secret-not-for-release
JWT_LIFETIME=14h
PEER_URL=
SYNC_SECRET=dev-only-sync-secret-not-for-release
# A well-known fake key, shared with cloud.env.defaults so that a dev clinic
# and a dev cloud can sync and restore each other's databases.
DB_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
