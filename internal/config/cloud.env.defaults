# Dev defaults of the cloud build (-tags cloud), embedded at build time. They
# are public: every secret below is a dev value, and a stamped release build
# refuses to start with any of them. Real values go in cloud.env (git-ignored;
# start from cloud.env.example), where a non-empty value replaces the default.
PORT=8080
JWT_SECRET=dev-only-cloud-jwt-secret-not-for-release
JWT_LIFETIME=14h
SYNC_SECRET=dev-only-sync-secret-not-for-release
PUBLIC_URL=
PUBLISH_SECRET=dev-only-publish-secret-not-for-release
# A well-known fake key, shared with local.env.defaults so that a dev clinic
# and a dev cloud can sync and restore each other's databases.
DB_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
