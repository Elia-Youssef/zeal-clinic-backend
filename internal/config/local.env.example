# Local config of the clinic build. Copy this file to local.env (git-ignored)
# and fill in the keys to change: it is embedded at build time, and a non-empty
# value replaces the dev default of local.env.defaults. A release build needs
# every secret here, with the same SYNC_SECRET and DB_ENCRYPTION_KEY as cloud.env.

# Port of the API and the dashboard.
PORT=
# Key that signs the sign-in tokens, 32 characters or more.
JWT_SECRET=
# How long a sign-in token stays valid, as a Go duration (14h).
JWT_LIFETIME=
# URL of the cloud replica; empty keeps the sync off.
PEER_URL=
# Shared secret of the sync with the cloud (the same value in cloud.env).
SYNC_SECRET=
# At-rest key of the database, 64 hex characters (the same value in cloud.env).
DB_ENCRYPTION_KEY=
# IANA time zone of the clinic (default Asia/Beirut).
CLINIC_TIMEZONE=
