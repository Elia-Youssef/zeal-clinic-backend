# Local config of the cloud build (-tags cloud). Copy this file to cloud.env
# (git-ignored) and fill in the keys to change: it is embedded at build time,
# and a non-empty value replaces the dev default of cloud.env.defaults. A release
# build needs every secret here, with the same SYNC_SECRET and DB_ENCRYPTION_KEY
# as local.env.

# Port of the API and the dashboard.
PORT=
# Key that signs the sign-in tokens, 32 characters or more.
JWT_SECRET=
# How long a sign-in token stays valid, as a Go duration (14h).
JWT_LIFETIME=
# Shared secret of the sync with the clinic (the same value in local.env).
SYNC_SECRET=
# Public URL of this server, returned by /api/server-url.
PUBLIC_URL=
# Secret that enables POST /api/versions (publishing updates).
PUBLISH_SECRET=
# At-rest key of the database, 64 hex characters (the same value in local.env).
DB_ENCRYPTION_KEY=
# IANA time zone of the clinic (default Asia/Beirut).
CLINIC_TIMEZONE=
