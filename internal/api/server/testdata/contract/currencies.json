    },
    {
      "name": "PUT /api/currencies/:id with unknown ids",
      "request": {
        "method": "PUT",
        "path": "/api/currencies/00000000-0000-7000-8000-000000000000",
        "body": {}
      },
      "response": {
        "status": 404,
