// ============================================================
// SYSTEM TABLES
// ============================================================

Table users {
  id string [pk]
  username string [unique]
  password_hash string
  display_name string
  role string [note: 'super-admin | admin | staff | nurse']
  is_active bool
  created_at datetime
  updated_at datetime
}

Table tokens {
  id string [pk]
  token string [unique]
  user_id string [ref: > users.id]
  expires_at datetime
  created_at datetime
}

Table roles {
  name string [pk]
  label string
  scopes string
}

Table audit_log {
  id string [pk]
  user_id string [ref: > users.id]
  user_role string
  action string [note: 'create | update | delete']
  entity_type string
  entity_id string
  details string
  ip_address string
  created_at datetime
}

Table versions {
  id string [pk]
  version string
  platform string [note: 'windows | linux']
  url string
  sha256 string
  notes string
  created_at datetime
  Note: 'Advertised app builds. Inserted on cloud, synced to locals.'
}

// ============================================================
// ROOMS
// ============================================================

Table rooms {
  id string [pk]
  name string
  type string [note: 'Consultation | Procedure | General | Hospital']
  is_available bool
  created_at datetime
}

// ============================================================
// ALLERGIES & MEDICINES
// ============================================================

Table allergies {
  id string [pk]
  name string [unique]
  description string
  created_at datetime
}

Table medicines {
  id string [pk]
  name string
  description string
  created_at datetime
}

// ============================================================
// PROCEDURES
// ============================================================

Table procedure_types {
  id string [pk]
  name string
  description string
  created_at datetime
}

Table procedure_categories {
  id string [pk]
  name string
  description string
  parent_id string [ref: > procedure_categories.id]
  created_at datetime
}

Table procedures {
  id string [pk]
  name string
  type_id string [ref: > procedure_types.id]
  category_id string [ref: > procedure_categories.id]
  price_note string
  is_active bool
  remarks string
  includes string [note: 'JSON array']
  created_at datetime
  updated_at datetime
}

Table procedure_prices {
  id string [pk]
  procedure_id string [ref: > procedures.id]
  price float
  is_active bool
  created_at datetime
}

Table procedure_allergy_conflicts {
  id string [pk]
  procedure_id string [ref: > procedures.id]
  allergy_id string [ref: > allergies.id]
  notes string
  created_at datetime

  indexes {
    (procedure_id, allergy_id) [unique]
  }
}

// ============================================================
// PATIENTS
// ============================================================

Table patients {
  id string [pk]
  first_name string
  middle_name string
  last_name string
  gender string [note: 'Male | Female | "" (empty when unknown, e.g. legacy imports)']
  date_of_birth date
  contact string
  email string
  emergency_contact_name string
  emergency_contact_phone string
  weight float
  height float
  blood_type string
  country_id string [ref: > countries.id]
  city_id string [ref: > lebanon_cities.id]
  address string
  referral_id string [ref: > patients.id, note: 'nullable']
  referral_source string
  notes string
  created_at datetime
  updated_at datetime
}

Table patient_allergies {
  id string [pk]
  patient_id string [ref: > patients.id]
  allergy_id string [ref: > allergies.id]
  notes string
  created_at datetime

  indexes {
    (patient_id, allergy_id) [unique]
  }
}

Table patient_medicines {
  id string [pk]
  patient_id string [ref: > patients.id]
  medicine_id string [ref: > medicines.id]
  is_active bool
  notes string
  created_at datetime

  indexes {
    (patient_id, medicine_id) [unique]
  }
}

// ============================================================
// APPOINTMENT PROCEDURES
// ============================================================

Table appointment_procedures {
  id string [pk]
  patient_id string [ref: > patients.id]
  procedure_id string [ref: > procedures.id]
  appointment_id string [ref: > appointments.id]
  assigned_to_id string [ref: > employees.id]
  notes string
  created_at datetime
  updated_at datetime
}

// ============================================================
// TEAM MEMBERS
// ============================================================

Table employees {
  id string [pk]
  user_id string [ref: > users.id]
  first_name string
  last_name string
  role string
  contact string
  email string
  date_of_birth date
  employment_type string [note: 'Full-time | Part-time']
  created_at datetime
  updated_at datetime
}

Table employee_salaries {
  id string [pk]
  employee_id string [ref: > employees.id]
  amount float
  currency_id string [ref: > currencies.id, note: 'Defaults to USD (currencies.id = ISO code)']
  is_active bool
  effective_date date
  notes string
  created_at datetime
  updated_at datetime
}

Table employee_salary_preparations {
  id string [pk]
  employee_id string [ref: > employees.id]
  period_start date
  period_end date
  salary_id string
  transaction_id string
  currency_id string [ref: > currencies.id, note: 'Defaults to USD (currencies.id = ISO code)']
  base_salary float
  adjustment float
  prepared_amount float
  notes string
  created_by string
  created_at datetime

  indexes {
    (employee_id, period_start, period_end) [unique]
  }
}

// ============================================================
// APPOINTMENTS
// ============================================================

Table appointments {
  id string [pk]
  patient_id string [ref: > patients.id]
  room_id string [ref: > rooms.id]
  start_time datetime
  end_time datetime
  status string [note: 'Scheduled | In-Progress | Completed | Cancelled | Rescheduled']
  notes string
  cancel_notes string
  completion_notes string
  rescheduled_from string [ref: > appointments.id, note: 'nullable; original appointment this one replaced']
  created_at datetime
  updated_at datetime
}

// ============================================================
// SCHEDULE AVAILABILITY
// ============================================================

Table employee_schedules {
  id string [pk]
  employee_id string [ref: > employees.id]
  day_of_week int [note: '0-6']
  start_time string
  end_time string
  start_date date
  end_date date
  is_active bool
  created_at datetime
  updated_at datetime
}

Table holidays {
  id string [pk]
  name string
  start_date date
  end_date date
  notes string
  created_by string
  created_at datetime
  updated_at datetime
}

Table employee_schedule_changes {
  id string [pk]
  employee_id string [ref: > employees.id]
  type string [note: 'timeoff (subtracts hours) | overtime (adds hours)']
  start_date date
  end_date date
  start_time string [note: 'required for overtime; optional for timeoff (empty = full-day off). When set, the window applies to every day in [start_date, end_date]']
  end_time string
  status string [note: 'pending | accepted | rejected; only accepted affects schedule projection']
  notes string
  created_at datetime
  updated_at datetime
}

// ============================================================
// PRESCRIPTIONS
// ============================================================

Table prescriptions {
  id string [pk]
  patient_id string [ref: > patients.id]
  prescribed_by_id string [ref: > employees.id]
  start_date date
  end_date date
  created_at datetime
  updated_at datetime
}

Table prescription_medicines {
  id string [pk]
  medicine_id string [ref: > medicines.id]
  prescription_id string [ref: > prescriptions.id]
  instructions string
  created_at datetime
}

// ============================================================
// STOCK MANAGEMENT
// ============================================================

Table product_categories {
  id string [pk]
  name string
  description string
  parent_id string [ref: > product_categories.id]
  created_at datetime
}

Table products {
  id string [pk]
  name string
  category_id string [ref: > product_categories.id]
  quantity int
  min_threshold int
  created_at datetime
}

Table product_prices {
  id string [pk]
  product_id string [ref: > products.id]
  price float
  is_active bool
  created_at datetime
}

Table product_allergy_conflicts {
  id string [pk]
  product_id string [ref: > products.id]
  allergy_id string [ref: > allergies.id]
  notes string
  created_at datetime

  indexes {
    (product_id, allergy_id) [unique]
  }
}

// ============================================================
// SUPPLIERS
// ============================================================

Table suppliers {
  id string [pk]
  name string
  contact string
  email string
  address string
  notes string
  created_at datetime
  updated_at datetime
}

// ============================================================
// EXPENSES
// ============================================================

Table expenses {
  id string [pk]
  name string
  notes string
  created_at datetime
  updated_at datetime
}

// ============================================================
// FINANCIAL
// ============================================================

Table currencies {
  id string [pk, note: 'ISO 4217 code (e.g. USD) — natural key, equals code']
  code string [unique]
  name string
  symbol string
  exchange_rate float
  created_at datetime
  updated_at datetime
}

Table balances {
  id string [pk]
  entity_type string [note: 'patient | employee | self | supplier | expense']
  entity_id string [note: 'Polymorphic FK to patients/employees/suppliers/expenses']
  entity_name string
  currency_id string [ref: > currencies.id, note: 'Defaults to USD (currencies.id = ISO code)']
  amount float [note: 'Cached projection from active balance_transactions']
  total_in float [note: 'Cached cash-flow projection from active balance_transactions']
  total_out float [note: 'Cached cash-flow projection from active balance_transactions']
  created_at datetime
  updated_at datetime

  indexes {
    (entity_type, entity_id, currency_id) [unique]
  }
}

Table balance_transactions {
  id string [pk]
  from_balance_id string [ref: > balances.id]
  to_balance_id string [ref: > balances.id]
  amount float
  currency_id string [ref: > currencies.id, note: 'Defaults to USD (currencies.id = ISO code)']
  transaction_type string [note: 'charge | payment | refund | adjustment | write-off']
  transaction_method string [note: 'cash | card | transfer | discount | other']
  source_type string [note: 'optional originating entity, e.g. employee_salary_preparation']
  source_id string [note: 'optional originating row id']
  description string
  created_by string
  created_at datetime
  voided_at datetime [note: "Empty string means active; voided rows are ignored by projections and lists"]
}

Table invoices {
  id string [pk]
  invoice_number int
  from_balance_id string [ref: > balances.id]
  to_balance_id string [ref: > balances.id]
  amount float
  discount_id string [ref: > discounts.id, note: 'optional offer applied to whole invoice']
  discount_value float
  final_amount float [note: 'amount after discounts']
  currency_id string [ref: > currencies.id, note: 'Defaults to USD (currencies.id = ISO code)']
  notes string
  created_by string
  created_at datetime
  updated_at datetime
  voided_at string [note: 'soft-delete marker; empty = active. Set on delete so it replicates']
}

Table invoice_items {
  id string [pk]
  invoice_id string [ref: > invoices.id]
  item_type string [note: 'product | procedure | gift | other']
  item_id string
  quantity int
  amount float
  final_amount float [note: 'per-line amount after discount']
  notes string
  created_at datetime
}

// ============================================================
// DISCOUNTS
// ============================================================

// Offer discounts: applied to a whole invoice via invoices.discount_id.
// Gift discounts: created via an invoice line (item_type='gift') and have
// exactly one of patient_id (credit applied at creation) or code (redeemed later).
Table discounts {
  id string [pk]
  name string
  description string
  discount_type string [note: 'offer | gift']
  value_type string [note: 'percentage | fixed']
  value float
  patient_id string [ref: > patients.id, note: 'gift only, nullable']
  code string [unique, note: 'gift only, nullable']
  redeemed_at datetime [note: 'gift only, marks code as consumed']
  start_date date [note: 'nullable']
  end_date date [note: 'nullable']
  is_active bool
  created_at datetime
  updated_at datetime
}

// ============================================================
// NOTIFICATIONS
// ============================================================

Table notifications {
  id string [pk]
  user_id string [ref: > users.id]
  title string
  description string
  action string
  is_read bool
  created_at datetime
}

// ============================================================
// LOOKUP TABLES
// ============================================================

Table countries {
  id string [pk]
  name string [unique]
}

Table lebanon_cities {
  id string [pk]
  name string
  governorate string
  district string
}

// ============================================================
// SYNC
// ============================================================

Table sync_log {
  seq int [pk, increment]
  table_name string
  row_id string
  op string [note: 'insert | update | delete']
  created_at datetime

  indexes {
    (table_name, row_id)
  }
}

Table sync_state {
  peer string [pk]
  last_pushed_seq int
  last_pulled_seq int
  updated_at datetime
}

Table sync_conflicts {
  id string [pk]
  table_name string
  row_id string
  local_json string
  remote_json string
  resolution string [note: 'local_wins | no_delete']
  created_at datetime

  indexes {
    created_at
  }
}

Table _sync_applying {
  rowid int [pk, note: 'single guard row']
  applying bool
}
